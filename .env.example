# Local configuration template. Copy to .env and use your own credentials.
# LangGraph A1-A8 runs without LLM calls with the settings below.
# Before enabling LLM features, set your authorized model, endpoint and API key.
# Credentials and the private model endpoint are intentionally not copied.

# ======================================================================
# 1. WEB SERVER AND DATABASE
# ======================================================================

# Environment label; currently reserved and does not change application behavior.
PLANT_ENVIRONMENT=development

# Server address: 127.0.0.1 allows this computer only; 0.0.0.0 listens on all network interfaces.
PLANT_HOST=127.0.0.1

# Web server port used when no --port argument is supplied.
PLANT_PORT=8060

# Reserved flag; the current application initializes its databases automatically.
PLANT_INITIALIZE_DATABASE=true

# Reserved worker label; the current worker does not read this setting.
PLANT_WORKER_ID=local-worker


# ======================================================================
# 2. MODEL CONNECTION AND CREDENTIALS
# ======================================================================

# Model name or deployment name accepted by your configured model endpoint.
PLANT_AGENT_MODEL=gpt-6-sol

# Base URL of your model API service; use the endpoint that matches your API key and model.
OPENAI_BASE_URL=https://api.openai.com/v1/

# Secret API key for your model endpoint; keep it private and out of Git.
OPENAI_API_KEY=


# ======================================================================
# 3. CONVERSATIONAL CHAT
# ======================================================================

# Conversational tool selection uses the same model/key/endpoint, independently
# of the optional per-stage Deep Agents and correction-advisor switches.
# Missing model credentials disables chat without disabling the existing app.
# Enable conversational chat with the configured model/key/endpoint; defaults to true when omitted.
PLANT_CHAT_ENABLED=true


# ======================================================================
# 4. LLM CORRECTION ADVICE
# ======================================================================

# Enable LLM correction advice and Deep Agent model access; chat has a separate enable switch.
PLANT_LLM_ENABLED=false

# Maximum LLM correction-advisor calls per workflow; this is not the chat tool-call limit.
PLANT_MODEL_CALL_LIMIT=6


# ======================================================================
# 5. DEEP AGENTS FOR A1-A8
# ======================================================================

# Use Deep Agents around A1-A8 when true; also requires PLANT_LLM_ENABLED and valid model credentials.
PLANT_DEEP_AGENTS_ENABLED=false

# Maximum total Deep Agent model calls per workflow; each stage also has its own smaller cap.
PLANT_DEEP_AGENT_MODEL_CALL_LIMIT=64


# ======================================================================
# 6. ENGINEERING WORKFLOW, RETRIES AND TIME LIMITS
# ======================================================================

# Workflow mode: poc1_automation, poc2_automation or reviewed_engineering.
PLANT_WORKFLOW_MODE=poc2_automation

# Allow live engineering readiness checks when true; false blocks live workflow readiness.
PLANT_LIVE_ENGINEERING_ENABLED=true

# Maximum automatic STAAD frame-correction retries after the first attempt (Loop A).
PLANT_MAX_FRAME_REVISIONS=2

# Maximum automatic IDEA correction retries for a connection group (Loop B).
PLANT_MAX_CONNECTION_REVISIONS=2

# Default worker timeout without progress, in seconds; some solver stages use a separate budget.
PLANT_AGENT_TIMEOUT_SECONDS=180

# Maximum total time allowed for one engineering worker run, in seconds.
PLANT_RUN_TIMEOUT_SECONDS=3600


# ======================================================================
# 7. RDP ENGINEERING SOFTWARE CONNECTIONS
# ======================================================================

# Tekla installation bin folder containing the Open API DLLs; match the RDP machine installation.
TEKLA_BIN_PATH=C:/TeklaStructures/2025.0/bin

# Address and port of the running IDEA StatiCa Connection REST service.
IDEA_STATICA_BASE_URL=http://localhost:5000


# ======================================================================
# 8. OPTIONAL LANGSMITH TRACING
# ======================================================================

# Enable LangSmith SDK tracing when true; traced data is sent to the configured tracing service.
LANGSMITH_TRACING=false

# Secret LangSmith API key used when tracing is enabled; leave blank if unused.
LANGSMITH_API_KEY=

# LangSmith project name used to group traces when tracing is enabled.
LANGSMITH_PROJECT=plant-engineering


# ======================================================================
# 9. RESERVED ACCESS AND APPROVAL SETTINGS
# ======================================================================

# Reserved flag; the current application does not use it to enable authentication.
PLANT_AUTH_ENABLED=false

# Reserved engineer token; currently not checked by the application.
PLANT_ENGINEER_TOKEN=

# Reserved approver token; currently not checked by the application.
PLANT_APPROVER_TOKEN=

# Reserved setting; it currently does not change the analysis approval behavior.
PLANT_ANALYSIS_APPROVAL_MODE=automatic

# Reserved setting; it does not bypass the existing final human approval gate.
PLANT_PUBLICATION_APPROVAL_MODE=automatic
