# Local configuration template. Copy to .env and use your own credentials.
# LangGraph A1-A8 runs without LLM calls with the settings below.
# Before enabling LLM features, set your authorized model, endpoint and API key.
# Credentials and the private model endpoint are intentionally not copied.

PLANT_ENVIRONMENT=development
PLANT_HOST=127.0.0.1
PLANT_PORT=8060
PLANT_AUTH_ENABLED=false
PLANT_ENGINEER_TOKEN=
PLANT_APPROVER_TOKEN=
PLANT_INITIALIZE_DATABASE=true
PLANT_AGENT_MODEL=gpt-6-sol
OPENAI_API_KEY=
PLANT_MODEL_CALL_LIMIT=6
PLANT_AGENT_TIMEOUT_SECONDS=180
PLANT_RUN_TIMEOUT_SECONDS=3600
PLANT_MAX_FRAME_REVISIONS=2
PLANT_MAX_CONNECTION_REVISIONS=2
PLANT_LIVE_ENGINEERING_ENABLED=true
PLANT_WORKER_ID=local-worker
TEKLA_BIN_PATH=C:/TeklaStructures/2025.0/bin
IDEA_STATICA_BASE_URL=http://localhost:5000
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=plant-engineering
PLANT_ANALYSIS_APPROVAL_MODE=automatic
PLANT_PUBLICATION_APPROVAL_MODE=automatic
OPENAI_BASE_URL=https://api.openai.com/v1/
PLANT_WORKFLOW_MODE=poc2_automation
PLANT_DEEP_AGENTS_ENABLED=false
PLANT_DEEP_AGENT_MODEL_CALL_LIMIT=64
PLANT_LLM_ENABLED=false
